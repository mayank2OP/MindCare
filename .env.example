# =========================================================
# MindCare Signal - Environment Configuration
# Copy this file to '.env' and fill in your keys.
# =========================================================

# Application Settings
APP_NAME="MindCare Signal"
DEBUG=false

# LLM Provider Selection: 'gemini', 'groq', 'ollama', or 'offline'
LLM_PROVIDER="gemini"

# Google Gemini API Key (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Groq API Key (Free tier at https://console.groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: Local Ollama URL
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# RAG & Storage Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_CHUNKS=4

# Auto-open browser on local launch (set to false in Docker/Headless)
OPEN_BROWSER="true"


# JWT Authentication (change the secret in production!)
JWT_SECRET="your-secret-key-here"
JWT_EXPIRY_HOURS=24
